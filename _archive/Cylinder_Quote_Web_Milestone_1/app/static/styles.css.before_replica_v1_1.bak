:root{
  --aqua:#c9ffff;
  --aqua2:#baf8f8;
  --panel:#efefef;
  --border:#8d8d8d;
  --yellow:#fff59c;
  --blue:#e5f4ff;
  --ink:#111;
  --title:#0c2b6f;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#e8e8e8}
body{padding:8px}
button,input,select{font:inherit;color:#111}
.orderentry-window{width:min(100%,1360px);margin:0 auto;background:linear-gradient(#d7ffff,#c1fbfb);border:2px solid #888;box-shadow:0 1px 4px rgba(0,0,0,.25)}
.window-titlebar{height:46px;padding:8px 14px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#f1f6f8,#dce8ed);border-bottom:1px solid #8d8d8d;color:var(--title);font-size:22px}
.window-close{font-size:30px;font-weight:400;color:#111;line-height:1}
.orderentry-form{padding:16px 18px 10px}
.customer-area{display:grid;grid-template-columns:105px 1fr;gap:10px 10px;align-items:center;margin-bottom:12px}
.customer-area label{font-size:18px;font-weight:700}
.customer-area input,.customer-control{height:38px}
.customer-control{display:grid;grid-template-columns:1fr 34px}
.customer-control input{border-right:0}
.combo-arrow{border:1px solid #8e8e8e;background:#e9e9e9;padding:0;font-size:13px}
input,select{height:38px;border:1px solid #8b8b8b;border-radius:0;background:#fff;padding:4px 8px;box-shadow:inset 1px 1px 2px rgba(0,0,0,.16)}
select{padding-right:2px}
.cylinder-row{display:grid;grid-template-columns:1.05fr 1.08fr 1.08fr 1.08fr 1.08fr 1.08fr 1.08fr 1.08fr 1.08fr .8fr;gap:10px;align-items:end;margin:6px 0 14px}
.cylinder-row label{display:flex;flex-direction:column;gap:4px;text-align:center;font-size:17px;font-weight:700}
.cylinder-row label input,.cylinder-row label select{width:100%}
.c-dre{margin-left:14px}
.middle-area{display:grid;grid-template-columns:46% 54%;gap:18px;align-items:start}
.legacy-panel{border:1px solid #8e8e8e;background:#ededed;min-height:310px;position:relative}
.tabs{display:flex;position:relative;top:-1px;left:-1px}
.tab{min-width:145px;height:38px;padding:5px 14px;border:1px solid #8e8e8e;border-bottom:0;background:#efefef;font-size:17px;font-weight:700;cursor:pointer;color:#111;border-radius:0}
.tab.active{background:#fafafa;position:relative;z-index:2}
.tab-panel{display:none;padding:24px 18px 16px}
.tab-panel.active{display:block}
.special-columns{display:grid;grid-template-columns:1fr 1fr;grid-auto-flow:row;gap:10px 40px}
.legacy-option-row{display:grid;grid-template-columns:minmax(145px,1fr) 72px;gap:8px;align-items:center}
.legacy-option-row span{justify-self:end;background:var(--yellow);padding:4px 8px;font-size:16px;font-weight:700;white-space:nowrap}
.legacy-option-row input{width:72px;height:34px}
.yes-no-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 25px}
.yes-no-grid label{display:grid;grid-template-columns:1fr 90px;gap:10px;align-items:center;font-weight:700}
.yes-no-grid span{background:var(--yellow);padding:5px 8px;justify-self:end}
.parts-panel{min-height:310px;padding:18px 0 0}
.parts-header,.part-row{display:grid;grid-template-columns:150px minmax(250px,1fr) 64px 120px;gap:12px;align-items:center}
.parts-header{font-size:17px;font-weight:700;text-align:center;margin-bottom:8px}
.part-row{margin-bottom:8px}
.part-row input,.part-row select{height:38px;width:100%}
.bottom-area{display:grid;grid-template-columns:46% 54%;gap:18px;margin-top:14px;align-items:start}
.accessory-panel{min-height:320px}
.accessory-tab-grid{grid-template-columns:1fr 1fr;gap:10px 35px;padding-top:26px}
.accessory-tab-grid.active{display:grid}
.engineering-panel{min-height:320px;padding:0 0 10px;display:grid;grid-template-columns:1fr;align-content:start;position:relative}
.pressure-row{display:flex;justify-content:flex-end;margin:3px 0 14px}
.pressure-row label{display:grid;grid-template-columns:auto 145px;gap:12px;align-items:center;font-size:17px;font-weight:700}
.force-row{display:grid;grid-template-columns:160px 90px 1fr;gap:14px;align-items:center;margin:0 0 18px 55px}
.blue-label{background:var(--blue);padding:5px 10px;font-weight:700;text-align:center}
.tie-row{display:grid;grid-template-columns:190px 140px 130px 130px;gap:14px;align-items:end;margin-left:55px}
.tie-row .wide{align-self:center}
.tie-row label{display:flex;flex-direction:column;gap:5px;text-align:center;font-size:16px;font-weight:700}
.pricing-rows{width:330px;margin:20px 170px 0 auto;display:grid;gap:8px}
.pricing-rows label{display:grid;grid-template-columns:125px 1fr;align-items:center;font-size:17px;font-weight:700;text-align:right;gap:10px}
.pricing-rows label .blue-label{display:block}
.quote-button{position:absolute;right:18px;bottom:48px;width:120px;height:75px;border:3px double #777;background:#f2f2f2;font-size:25px;font-style:italic;font-weight:700;box-shadow:1px 1px 0 #aaa;cursor:pointer;color:#111}
.quote-button:active{transform:translate(1px,1px)}
.error{min-height:20px;margin:8px 0 0;color:#b42318;font-weight:700}
.statusbar{height:42px;border-top:1px solid #888;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;padding:0 16px;color:#092d7b;font-size:15px;background:#c8ffff}
.statusbar span:nth-child(2){text-align:center}.statusbar span:nth-child(3){text-align:right}
.quote-dialog{width:min(720px,92vw);border:2px solid #7e7e7e;padding:0;background:#e9ffff;box-shadow:0 10px 35px rgba(0,0,0,.35)}
.quote-dialog::backdrop{background:rgba(0,0,0,.38)}
.quote-dialog-inner{padding:0 16px 16px}
.dialog-title{margin:0 -16px 14px;padding:8px 12px;background:#e7eef2;border-bottom:1px solid #999;color:#0c2b6f;font-size:19px;font-weight:700}
.dialog-model{display:grid;grid-template-columns:90px 1fr;gap:10px;margin-bottom:12px}.dialog-model span{font-weight:700}.dialog-model strong{overflow-wrap:anywhere}
.dialog-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.dialog-grid>div{border:1px solid #999;background:#fff;padding:8px}.dialog-grid span{display:block;font-size:12px;font-weight:700}.dialog-grid strong{font-size:18px}
.quote-dialog details{margin-top:12px}.breakdown-list{margin:8px 0}.breakdown-list div{display:flex;justify-content:space-between;border-bottom:1px solid #bbb;padding:5px}.breakdown-list dd{margin:0;font-weight:700}
.warnings{background:#fff7cc;border:1px solid #c9b761;padding:9px;margin-top:10px}.dialog-close{display:block;margin:14px 0 0 auto;padding:7px 20px}
@media(max-width:1050px){body{overflow-x:auto}.orderentry-window{min-width:1000px}}
