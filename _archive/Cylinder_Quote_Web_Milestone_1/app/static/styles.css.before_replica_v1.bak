:root { --ink:#16212f; --muted:#667085; --line:#d8dee8; --panel:#ffffff; --page:#f4f6f9; --accent:#1c5d99; --accent2:#0f4778; --soft:#eaf2f9; --warning:#fff6df; --error:#b42318; }
* { box-sizing:border-box; }
body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; color:var(--ink); background:var(--page); }
.shell { max-width:1500px; margin:0 auto; padding:26px; }
.topbar { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:20px; }
.eyebrow { margin:0 0 4px; text-transform:uppercase; letter-spacing:.12em; font-size:12px; font-weight:700; color:var(--accent); }
h1 { margin:0; font-size:30px; }
.subtitle { margin:5px 0 0; color:var(--muted); }
.status { padding:9px 12px; border:1px solid var(--line); border-radius:999px; background:white; color:var(--muted); font-size:13px; }
.layout { display:grid; grid-template-columns:minmax(0, 1.8fr) minmax(340px,.8fr); gap:20px; align-items:start; }
.panel { background:var(--panel); border:1px solid var(--line); border-radius:14px; box-shadow:0 6px 22px rgba(29,43,61,.06); }
.form-panel { padding:22px; }
.results-panel { padding:22px; position:sticky; top:18px; }
.section-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
.section-heading h2 { margin:0; font-size:19px; }
.section-heading span { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.08em; }
.grid { display:grid; gap:13px; margin-bottom:14px; }
.grid.four { grid-template-columns:repeat(4,minmax(0,1fr)); }
.grid.three { grid-template-columns:repeat(3,minmax(0,1fr)); }
label { display:flex; flex-direction:column; gap:6px; font-size:12px; font-weight:700; color:#344054; }
input, select { width:100%; min-height:40px; border:1px solid #cbd3df; border-radius:8px; background:white; padding:8px 10px; color:var(--ink); font:inherit; font-weight:500; }
input:focus, select:focus { outline:2px solid #b8d5ec; border-color:var(--accent); }
label.check { flex-direction:row; align-items:center; gap:9px; min-height:40px; padding-top:19px; }
label.check input { width:18px; min-height:18px; }
details { border-top:1px solid var(--line); padding:15px 0 0; margin-top:15px; }
summary { cursor:pointer; font-weight:750; color:#26384d; margin-bottom:12px; }
.details-grid { padding-top:4px; }
.hint { color:var(--muted); font-size:13px; }
.special-row { display:grid; grid-template-columns:1fr 110px 36px; gap:8px; margin-bottom:8px; }
.actions { display:flex; gap:10px; margin-top:20px; }
button { border:0; border-radius:9px; padding:11px 18px; background:var(--accent); color:white; font-weight:750; cursor:pointer; }
button:hover { background:var(--accent2); }
button.secondary { background:#eef2f6; color:#344054; }
.error { color:var(--error); font-size:13px; min-height:18px; }
.model-card { background:var(--soft); border-radius:10px; padding:15px; margin-bottom:14px; }
.model-card span, .price-grid span { display:block; font-size:11px; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); margin-bottom:5px; }
.model-card strong { font-size:17px; overflow-wrap:anywhere; }
.price-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.price-grid > div { border:1px solid var(--line); border-radius:10px; padding:13px; }
.price-grid strong { font-size:20px; }
.price-grid .primary-price { grid-column:1/-1; background:#f0f7fd; border-color:#b7d6ef; }
.price-grid .primary-price strong { font-size:30px; color:var(--accent2); }
.breakdown dl { margin:8px 0 0; }
.breakdown dl div { display:flex; justify-content:space-between; gap:15px; padding:7px 0; border-bottom:1px solid #edf0f4; }
dt { color:var(--muted); font-size:13px; }
dd { margin:0; font-weight:700; font-size:13px; }
.warnings { margin-top:15px; padding:13px; background:var(--warning); border-radius:9px; font-size:12px; }
.warnings ul { padding-left:18px; margin-bottom:0; }
.scope-note { margin:17px 0 0; color:var(--muted); font-size:12px; line-height:1.45; }
@media (max-width:1050px) { .layout{grid-template-columns:1fr;} .results-panel{position:static;} }
@media (max-width:760px) { .grid.four,.grid.three{grid-template-columns:1fr 1fr;} .topbar{align-items:flex-start;flex-direction:column;} }
@media (max-width:520px) { .shell{padding:12px;} .grid.four,.grid.three{grid-template-columns:1fr;} .price-grid{grid-template-columns:1fr;} .price-grid .primary-price{grid-column:auto;} }
