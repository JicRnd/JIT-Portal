{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "AppMap: Record Python Tests",
            "type": "shell",
            "command": "Set-Location \"${workspaceFolder}\\\\Cylinder_Quote_Web_Milestone_1\"; $env:APPMAP=true; pytest",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Start LiteLLM Proxy Agent",
            "type": "shell",
            "command": "${workspaceFolder}\\\\Cylinder_Quote_Web_Milestone_1\\\\.venv\\\\Scripts\\\\python.exe ${workspaceFolder}\\\\.vscode\\\\chat_gateway.py",
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Running on.*"
                }
            }
        }
    ]
}
