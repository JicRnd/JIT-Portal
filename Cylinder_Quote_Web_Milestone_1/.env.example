# Database
# Path is relative to the project root by default.
DATABASE_PATH=Databases/Application.db

# Generated quote PDF storage
# Defaults to instance/quote_documents under the project root.
# QUOTE_DOCUMENTS_DIR=instance/quote_documents

# Current user fallback
# Used when a request provides neither the X-User-Name header nor a
# current_user field in the JSON body.
DEFAULT_USER_NAME=dev

# Quote number format
# {year} and {seq} are substituted at generation time.
# This is the single configuration point for the JIT numbering convention.
QUOTE_NUMBER_FORMAT=DEV-{year}-{seq:05d}

# Future: Data1 approval integration (implemented in a later phase)
# DATA1_BASE_URL=
# DATA1_APPROVAL_ENDPOINT=/api/approved-quote

# Email integration (Phase 5)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=

# Internal Order Form approval email
ORDER_APPROVAL_RECIPIENT=kane@jitindustries.com
# Set this to an address reachable by employees, for example http://192.168.1.50:5055
# ORDER_APPROVAL_BASE_URL=http://127.0.0.1:5055
