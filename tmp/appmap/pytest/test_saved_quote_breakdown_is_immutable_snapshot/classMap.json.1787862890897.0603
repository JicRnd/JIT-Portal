  {
    "type": "database",
    "name": "Database",
    "children": [
      {
        "type": "query",
        "name": "SELECT users.id, users.display_name, users.email, users.username, users.password_hash, users.role, users.access_level, users.company_name, users.phone, users.phone_extension, users.shipping_name, users.shipping_address, users.billing_address, users.shipping_same_as_billing, users.assigned_promo_code, users.assigned_discount_percent, users.approval_status, users.is_active, users.created_at \nFROM users \nWHERE lower(users.display_name) = ?"
      },
      {
        "type": "query",
        "name": "INSERT INTO users (display_name, email, username, password_hash, role, access_level, company_name, phone, phone_extension, shipping_name, shipping_address, billing_address, shipping_same_as_billing, assigned_promo_code, assigned_discount_percent, approval_status, is_active, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
      },
      {
        "type": "query",
        "name": "SAVEPOINT sa_savepoint_1"
      },
      {
        "type": "query",
        "name": "SELECT quotes.id \nFROM quotes \nWHERE quotes.quote_number = ?\n LIMIT ? OFFSET ?"
      },
      {
        "type": "query",
        "name": "INSERT INTO quotes (quote_number, status, customer_name, customer_address, customer_contact, customer_reference, comments, special_instructions, pricing_version, revision, quantity, discount, model_code, cylinder_inputs_snapshot, price_breakdown_snapshot, created_by_user_id, created_at, edited_by_user_id, edited_at, emailed_by_user_id, emailed_at, approved_by_user_id, approved_at, assigned_employee_user_id, assigned_at, customer_update_pending) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
      },
      {
        "type": "query",
        "name": "RELEASE SAVEPOINT sa_savepoint_1"
      },
      {
        "type": "query",
        "name": "SELECT customers.id, customers.name, customers.address, customers.city_state_zip, customers.phone, customers.email, customers.created_at, customers.updated_at \nFROM customers \nWHERE lower(customers.name) = ?"
      },
      {
        "type": "query",
        "name": "INSERT INTO customers (name, address, city_state_zip, phone, email, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)"
      },
      {
        "type": "query",
        "name": "SELECT quote_line_items.id AS quote_line_items_id, quote_line_items.quote_id AS quote_line_items_quote_id, quote_line_items.reference_part_number AS quote_line_items_reference_part_number, quote_line_items.description AS quote_line_items_description, quote_line_items.quantity AS quote_line_items_quantity, quote_line_items.unit_price AS quote_line_items_unit_price, quote_line_items.extended_price AS quote_line_items_extended_price, quote_line_items.internal_note AS quote_line_items_internal_note, quote_line_items.show_on_customer_quote AS quote_line_items_show_on_customer_quote, quote_line_items.sort_order AS quote_line_items_sort_order \nFROM quote_line_items \nWHERE ? = quote_line_items.quote_id ORDER BY quote_line_items.sort_order"
      },
      {
        "type": "query",
        "name": "SELECT users.id AS users_id, users.display_name AS users_display_name, users.email AS users_email, users.username AS users_username, users.password_hash AS users_password_hash, users.role AS users_role, users.access_level AS users_access_level, users.company_name AS users_company_name, users.phone AS users_phone, users.phone_extension AS users_phone_extension, users.shipping_name AS users_shipping_name, users.shipping_address AS users_shipping_address, users.billing_address AS users_billing_address, users.shipping_same_as_billing AS users_shipping_same_as_billing, users.assigned_promo_code AS users_assigned_promo_code, users.assigned_discount_percent AS users_assigned_discount_percent, users.approval_status AS users_approval_status, users.is_active AS users_is_active, users.created_at AS users_created_at \nFROM users \nWHERE users.id = ?"
      },
      {
        "type": "query",
        "name": "SELECT quotes.id, quotes.quote_number, quotes.status, quotes.customer_name, quotes.customer_address, quotes.customer_contact, quotes.customer_reference, quotes.comments, quotes.special_instructions, quotes.order_form_snapshot, quotes.pricing_version, quotes.revision, quotes.quantity, quotes.discount, quotes.model_code, quotes.cylinder_inputs_snapshot, quotes.price_breakdown_snapshot, quotes.created_by_user_id, quotes.created_at, quotes.edited_by_user_id, quotes.edited_at, quotes.emailed_by_user_id, quotes.emailed_at, quotes.approved_by_user_id, quotes.approved_at, quotes.assigned_employee_user_id, quotes.assigned_at, quotes.customer_update_pending \nFROM quotes \nWHERE quotes.id = ?"
      },
      {
        "type": "query",
        "name": "SELECT users.id AS users_id, users.display_name AS users_display_name, users.email AS users_email, users.username AS users_username, users.password_hash AS users_password_hash, users.role AS users_role, users.access_level AS users_access_level, users.company_name AS users_company_name, users.phone AS users_phone, users.phone_extension AS users_phone_extension, users.shipping_name AS users_shipping_name, users.shipping_address AS users_shipping_address, users.billing_address AS users_billing_address, users.shipping_same_as_billing AS users_shipping_same_as_billing, users.assigned_promo_code AS users_assigned_promo_code, users.assigned_discount_percent AS users_assigned_discount_percent, users.approval_status AS users_approval_status, users.is_active AS users_is_active, users.created_at AS users_created_at \nFROM users \nWHERE users.id IN (?)"
      },
      {
        "type": "query",
        "name": "SELECT quote_line_items.quote_id AS quote_line_items_quote_id, quote_line_items.id AS quote_line_items_id, quote_line_items.reference_part_number AS quote_line_items_reference_part_number, quote_line_items.description AS quote_line_items_description, quote_line_items.quantity AS quote_line_items_quantity, quote_line_items.unit_price AS quote_line_items_unit_price, quote_line_items.extended_price AS quote_line_items_extended_price, quote_line_items.internal_note AS quote_line_items_internal_note, quote_line_items.show_on_customer_quote AS quote_line_items_show_on_customer_quote, quote_line_items.sort_order AS quote_line_items_sort_order \nFROM quote_line_items \nWHERE quote_line_items.quote_id IN (?) ORDER BY quote_line_items.sort_order"
